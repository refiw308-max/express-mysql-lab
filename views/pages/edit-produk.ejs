<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Produk</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="container">
        <h1>Edit Produk</h1>
        <p>Ubah informasi produk di bawah ini.</p>

        <form
            action="/produk/<%= produk.id %>/update"
            method="POST"
            class="product-form"
        >
            <label for="nama_produk">Nama Produk</label>
            <input
                type="text"
                id="nama_produk"
                name="nama_produk"
                value="<%= produk.nama_produk %>"
                maxlength="100"
                required
            >

            <label for="kategori">Kategori</label>
            <input
                type="text"
                id="kategori"
                name="kategori"
                value="<%= produk.kategori %>"
                maxlength="50"
                required
            >

            <label for="harga">Harga (Rp)</label>
            <input
                type="number"
                id="harga"
                name="harga"
                value="<%= produk.harga %>"
                min="0"
                step="0.01"
                required
            >

            <label for="stok">Stok</label>
            <input
                type="number"
                id="stok"
                name="stok"
                value="<%= produk.stok %>"
                min="0"
                step="1"
                required
            >

            <button type="submit">Simpan Perubahan</button>
            <a href="/">Batal</a>
        </form>
    </main>
</body>
</html>